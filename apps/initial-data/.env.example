# Configuration for the standalone initial-data app only.
# Use the same database and media bucket as the main application when importing.
DATABASE_URL=postgresql://akiraminafit:replace-with-a-strong-database-password@localhost:5432/akiraminafit

# An existing coach; no password is needed for imports.
COACH_EMAIL=coach@example.com

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-with-a-minio-access-key
S3_SECRET_KEY=replace-with-a-strong-minio-secret-key
S3_BUCKET=akiraminafit-media
S3_PUBLIC_URL=http://localhost:9000/akiraminafit-media
S3_FORCE_PATH_STYLE=true
