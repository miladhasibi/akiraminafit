{
  "name": "@akiraminafit/initial-data",
  "version": "0.1.0",
  "private": true,
  "description": "دریافت داده‌ی اولیه: دریافت و وارد کردن بانک حرکات و رسانه‌ها",
  "type": "module",
  "scripts": {
    "scrape": "node --import tsx src/cli.ts scrape",
