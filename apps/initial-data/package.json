    "drizzle-orm": "^0.45.2",
    "happy-dom": "^21.0.4",
    "tsx": "^4.20.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "typescript": "^5.9.2"
  }
}
